#: tickets\commands\admin.py:1296
#, docstring
msgid ""
"\n"
"        Toggle blocking ticket creation outside working hours\n"
"\n"
"        When enabled, users cannot create tickets outside of the configured working hours.\n"
"        When disabled (default), users can still create tickets but will see a notice about delayed responses.\n"
"        "
msgstr ""
"Bloccare la creazione di biglietti fuori orario di lavoro\n"
"\n"
"Quando abilitato, gli utenti non possono creare biglietti al di fuori delle ore di lavoro configurate.\n"
"Quando disabilitato (default), gli utenti possono ancora creare biglietti, ma vedrà un avviso sulle risposte ritardate.\n"

#: tickets\commands\admin.py:1312
msgid "Ticket creation is now **blocked** outside of working hours for {}"
msgstr ""
"La creazione di biglietti è ora bloccata al di fuori dell'orario di lavoro "
"per {}"

